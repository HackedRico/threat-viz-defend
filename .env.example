# ThreatViz Defend backend settings.
#
# Copy to .env and edit. The values below suit a local run (docker compose up,
# or uv run in api/). Lines marked "Production:" give the value App Platform
# uses; docs/deploy.md has the full list. Never commit a filled-in .env.
# Blank means unset, and the server uses its default.

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# development, production or test. Production: production.
APP_ENV=development
# Name shown in the page title and the API docs.
APP_NAME="ThreatViz Defend"
# Where the API is reached, scheme and host only. Production: https://api.example.com
PUBLIC_ORIGIN=
# Extra Host headers to accept, comma separated. PUBLIC_ORIGIN's host is always allowed.
ALLOWED_HOSTS=
# SQLAlchemy URL. Blank uses SQLite in api/data. docker compose sets its own Postgres URL.
# Production: ${db.DATABASE_URL} from the App Platform database.
DATABASE_URL=
# Folder of the built web app to serve on the API's origin. The combined image sets /app/web/dist.
STATIC_DIR=
# Port uvicorn listens on inside the container.
PORT=8080

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# 32+ random characters that encrypt users' saved provider API keys. Required in production.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it later makes every saved provider key unreadable, so users must enter them again.
APP_SECRET=
# Exact browser origins of a frontend on another host, comma separated. Production: https://app.example.com
CORS_ORIGINS=
# Read the client IP from CLIENT_IP_HEADER. Only true behind a proxy that sets it. Production: true
TRUST_PROXY=false
# Header holding the real client IP. App Platform sets do-connecting-ip.
CLIENT_IP_HEADER=do-connecting-ip
# Secure cookies. Defaults to true in production and false otherwise.
COOKIE_SECURE=
# lax, strict or none. lax works when app. and api. share a parent domain. none needs COOKIE_SECURE=true.
COOKIE_SAMESITE=lax
# Let users point their own provider at private network addresses. Defaults to false in production.
ALLOW_PRIVATE_PROVIDER_URLS=

# -----------------------------------------------------------------------------
# Accounts
# -----------------------------------------------------------------------------
# Signup codes, comma separated, 6+ characters each in production. Blank in development means local-dev.
# Production: long random codes, rotated as needed; empty means nobody can sign up.
INVITE_CODES=
# Signups stop once this many accounts exist.
MAX_USERS=300
# Days a sign-in lasts, 1 to 30.
SESSION_DAYS=7

# -----------------------------------------------------------------------------
# Model provider default
# -----------------------------------------------------------------------------
# The server's own model. Without LLM_API_KEY and LLM_MODEL the app runs in demo mode.
# Users can also save their own provider in the app.
# OpenAI compatible base URL. DigitalOcean serverless inference: https://inference.do-ai.run/v1
LLM_BASE_URL=https://inference.do-ai.run/v1
# Model name at that provider.
LLM_MODEL=openai-gpt-oss-120b
# Key for that provider, such as a DigitalOcean model access key.
LLM_API_KEY=
# json_schema, json_object or prompt. Defaults to json_schema for OpenAI and prompt for other base URLs.
LLM_JSON_MODE=
# Seconds before a model call gives up, 5 to 600.
LLM_TIMEOUT_S=120
# Cap on output tokens per call. Blank or 0 leaves it to the provider.
LLM_MAX_TOKENS=

# -----------------------------------------------------------------------------
# Backboard
# -----------------------------------------------------------------------------
# Backboard API base URL, for users who pick Backboard as their provider.
BACKBOARD_BASE_URL=https://app.backboard.io/api

# -----------------------------------------------------------------------------
# Voice coach
# -----------------------------------------------------------------------------
# ElevenLabs key and agent. Voice is off unless both are set. scripts/elevenlabs_agent.py creates the agent.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# -----------------------------------------------------------------------------
# Budgets
# -----------------------------------------------------------------------------
# Model calls each user may make per day on the server's key.
DAILY_MODEL_CALLS=60
# Model calls each user may make per minute.
MODEL_CALLS_PER_MINUTE=6
# Model calls across all users per day on the server's key.
GLOBAL_DAILY_MODEL_CALLS=3000
# Voice sessions each user may start per day.
DAILY_VOICE_SESSIONS=10

# -----------------------------------------------------------------------------
# docker compose only
# -----------------------------------------------------------------------------
# Credentials for the local Postgres container. Compose builds DATABASE_URL from them.
POSTGRES_USER=threatviz
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=threatviz
