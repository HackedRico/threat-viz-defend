{
  "name": "threatviz-defend-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run copy:worklets",
    "dev": "vite",
    "prebuild": "npm run copy:worklets",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "copy:worklets": "mkdir -p public/vendor/elevenlabs && cp node_modules/@elevenlabs/client/worklets/rawAudioProcessor.js node_modules/@elevenlabs/client/worklets/audioConcatProcessor.js public/vendor/elevenlabs/",
    "gen:api": "cd ../api && uv run python -m app.openapi > ../web/openapi.json && cd ../web && npx --yes -p typescript@5.9.3 -p openapi-typescript@7.13.0 openapi-typescript openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@elevenlabs/react": "^1.15.2",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "elkjs": "^0.12.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "roughjs": "^4.6.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=24"
  }
}
